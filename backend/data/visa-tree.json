    "schengen": ["travel_insurance"],
    "france": ["travel_insurance"],
    "germany": ["travel_insurance"],
    "italy": ["travel_insurance"],
    "spain": ["travel_insurance"],
    "switzerland": ["travel_insurance"],
    "@children": ["birth_certificate", "parents_consent"],
