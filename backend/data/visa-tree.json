    "sch_professional_letter": {
      "label": "Letter on your professional letterhead"
    },
    "sch_entity_registration": {
      "label": "Registration documents of the entity, if registered"
    },
    "sch_degree": {
      "label": "Degree copy"
    },
    "sch_land_documents": {
      "label": "Land ownership documents, valuated, in English"
