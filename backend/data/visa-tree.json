    },
    "relationship_proof": {
      "label": "[PLACEHOLDER] Proof of relationship (marriage/birth certificates)"
    },
    "sch_passport": {
      "label": "Valid national passport, plus all your older passports, valid and expired",
      "note": "Issued within the last 10 years, valid at least 3 months after your return, with at least two blank pages. Handwritten passports and passports with observations on the front (bio data) page cannot be accepted."
    },
    "sch_photos": {
      "label": "2 new passport-size photographs (ICAO)",
      "note": "White background, not older than 6 months, 35-40 mm wide, not copied or scanned."
    },
    "sch_insurance": {
      "label": "Travel insurance, minimum cover EUR 30,000 / USD 50,000 per person",
      "note": "Must cover medical repatriation, urgent medical attention and emergency hospital treatment, for the entire stay in the Schengen area including travel days, and COVID."
    },
    "sch_flight": {
      "label": "Flight reservation with the names of all travellers",
      "note": "If applicable, also proof of intra-Schengen flight, train, ferry or car rental."
    },
    "sch_accommodation": {
      "label": "Hotel reservation confirmation for your complete stay in the Schengen area",
      "note": "For a package tour: advance payments and receipts, transport and flight reservations, and the complete package details."
    },
    "sch_bank_statements": {
      "label": "Personal bank account statements, latest 3 months, attested by the bank"
    },
    "sch_investments": {
      "label": "Copy of your investment portfolio, if applicable"
    },
    "sch_itr": {
      "label": "Personal income tax return, last 2 assessment years",
      "note": "Only the ITR-V (Indian Income Tax Return Verification Form) or acknowledgement is accepted."
    },
    "sch_aadhaar": {
      "label": "Aadhaar card copy"
    },
    "sch_passport_copy": {
      "label": "Copy of your current passport with all visa and immigration stamps"
    },
    "sch_lost_passport": {
      "label": "Proof of loss, if any passport was lost"
    },
    "sch_employment_contract": {
      "label": "Employment offer or contract"
    },
    "sch_intro_letter": {
      "label": "Original introduction letter on the employer or company letterhead",
